# Copy this file to .env and fill in the values. Never commit .env.

# Any long random string. Generate one with:
#   py -3.14 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Oracle user the app logs in as (created by sql/create_user.sql)
ORACLE_USER=studybuddy
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/XEPDB1

# Oracle user the tests log in as (created by sql/create_test_user.sql).
# The tests EMPTY this user's tables, so it must never be your real user.
ORACLE_TEST_USER=studybuddy_test
ORACLE_TEST_PASSWORD=
